class Solution:
    
    __PARENTHESES_MAPPING = {
        '{' : '}',
        '[' : ']',
        '(' : ')'
    }

    def isValid(self, s: str) -> bool:
        stack = []
        
        for char in s:
            if char in self.__PARENTHESES_MAPPING:
                stack.append(char)
                
            elif char in self.__PARENTHESES_MAPPING.values():
                if stack and self.__PARENTHESES_MAPPING[stack[-1]] == char:
                    stack.pop() 
                else:
                    return False
                
        return len(stack) == 0
